{
  "name": "@tonysamperi/ts-mapi-core",
  "version": "2.0.0",
  "description": "A set of shared utils to be used at BE or FE",
  "type": "module",
  "types": "./dist/esm/index.d.ts",
  "main": "./dist/cjs/index.cjs",
  "module": "./dist/esm/index.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.cts",
        "default": "./dist/cjs/index.cjs"
      },
      "browser": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      }
    },
    "./dynamo": {
      "import": {
        "types": "./dist/esm/dynamo.d.ts",
        "default": "./dist/esm/dynamo.js"
      },
      "require": {
        "types": "./dist/cjs/dynamo.d.cts",
        "default": "./dist/cjs/dynamo.cjs"
      }
    },
    "./firebase": {
      "import": {
        "types": "./dist/esm/firebase.d.ts",
        "default": "./dist/esm/firebase.js"
      },
      "require": {
        "types": "./dist/cjs/firebase.d.cts",
        "default": "./dist/cjs/firebase.cjs"
      }
    },
    "./rxjs": {
      "import": {
        "types": "./dist/esm/rxjs.d.ts",
        "default": "./dist/esm/rxjs.js"
      },
      "require": {
        "types": "./dist/cjs/rxjs.d.cts",
        "default": "./dist/cjs/rxjs.cjs"
      }
    },
    "./zod": {
      "import": {
        "types": "./dist/esm/zod.d.ts",
        "default": "./dist/esm/zod.js"
      },
      "require": {
        "types": "./dist/cjs/zod.d.cts",
        "default": "./dist/cjs/zod.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "typesVersions": {
    "*": {
      "": [
        "./dist/cjs/index.d.cts"
      ],
      "dynamo": [
        "./dist/cjs/dynamo.d.cts"
      ],
      "firebase": [
        "./dist/cjs/firebase.d.cts"
      ],
      "rxjs": [
        "./dist/cjs/rxjs.d.cts"
      ],
      "zod": [
        "./dist/cjs/zod.d.cts"
      ]
    }
  },
  "sideEffects": false,
  "files": [
    "dist/**",
    "changelog.md"
  ],
  "scripts": {
    "build:dev": "NODE_ENV=development node build.config",
    "build": "NODE_ENV=production node build.config",
    "build:cjs": "webpack --config webpack.cjs.config.cjs --stats verbose",
    "check-exports": "node scripts/check-exports.js",
    "lint": "eslint && tsc --noEmit",
    "prepublishOnly": "npm run build && npm run check-exports",
    "release": "npm publish --access public --provenance",
    "release:beta": "npm publish --access public --tag beta --provenance",
    "release:next": "npm publish --access public --tag next --provenance",
    "test": "jest"
  },
  "author": "Tony Samperi",
  "repository": {
    "type": "git",
    "url": "https://github.com/tonysamperi/ts-mapi-core"
  },
  "license": "ISC",
  "peerDependencies": {
    "@aws-sdk/client-dynamodb": "^3.758.0",
    "@aws-sdk/util-dynamodb": "^3.758.0",
    "@tonysamperi/logger": "^2.0.0",
    "class-transformer": "^0.5.1",
    "firebase": "^11.4.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.5.6",
    "ts-luxon": "^6.0.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@aws-sdk/client-dynamodb": "^3.758.0",
    "@aws-sdk/util-dynamodb": "^3.758.0",
    "@babel/preset-env": "^7.28.5",
    "@pollyjs/adapter-fetch": "^6.0.6",
    "@pollyjs/core": "^6.0.6",
    "@pollyjs/persister-fs": "^6.0.6",
    "@swc/core": "^1.13.2",
    "@tonysamperi/krypto": "^1.1.0",
    "@tonysamperi/logger": "^2.0.0",
    "@types/babel__preset-env": "^7",
    "@types/jest": "~29.5.14",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^22.13.8",
    "@types/setup-polly-jest": "^0",
    "@typescript-eslint/eslint-plugin": "^8.32.0",
    "@typescript-eslint/parser": "^8.32.0",
    "babel-jest": "^30.2.0",
    "class-transformer": "^0.5.1",
    "eslint": "^9.26.0",
    "firebase": "^11.4.0",
    "glob": "^11.1.0",
    "jest": "~29.7.0",
    "lodash-es": "^4.17.23",
    "reflect-metadata": "^0.2.2",
    "replace-in-file": "^8.3.0",
    "rxjs": "^7.5.6",
    "setup-polly-jest": "^0.11.0",
    "ts-jest": "^29.2.6",
    "ts-luxon": "^6.0.0",
    "tslib": "^2.8.1",
    "tsup": "^8.4.0",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.32.0",
    "zod": "^3.24.4"
  },
  "packageManager": "yarn@4.3.1"
}
